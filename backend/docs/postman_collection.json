{
  "info": {
    "_postman_id": "9f82b5a4-3d91-4d7c-91a1-inventoryapi2026",
    "name": "Sistem Manajemen Inventaris Barang API (Golang MVC)",
    "description": "Dokumentasi Postman Collection untuk Take-Home Test Backend Developer Golang.\n\nUrutan Pengujian:\n1. Jalankan **Register User**\n2. Jalankan **Login User** (Token JWT akan otomatis tersimpan ke collection variable `token`)\n3. Jalankan endpoint **CRUD Barang** (`POST /items`, `GET /items`, `PUT /items/:id`, `DELETE /items/:id`)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Muhammad Faiz\",\n  \"email\": \"faiz@example.com\",\n  \"password\": \"rahasia123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"faiz@example.com\",\n  \"password\": \"rahasia123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. CRUD Barang (Items)",
      "item": [
        {
          "name": "Create Item (POST /items)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MacBook Pro M3 14 Inch\",\n  \"description\": \"Laptop operasional tim engineering RAM 16GB SSD 512GB\",\n  \"stock\": 15,\n  \"price\": 28500000\n}"
            },
            "url": {
              "raw": "{{base_url}}/items",
              "host": ["{{base_url}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Create Item - Uji Validasi Stok Negatif (Ditolak 400)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Barang Stok Minus\",\n  \"description\": \"Harus gagal karena stok negatif\",\n  \"stock\": -5,\n  \"price\": 50000\n}"
            },
            "url": {
              "raw": "{{base_url}}/items",
              "host": ["{{base_url}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Get Items - Search & Pagination (GET /items)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/items?search=MacBook&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["items"],
              "query": [
                {
                  "key": "search",
                  "value": "MacBook"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Item By ID (GET /items/:id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        },
        {
          "name": "Update Item (PUT /items/:id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MacBook Pro M3 14 Inch (Updated)\",\n  \"description\": \"Stok diperbarui setelah audit gudang\",\n  \"stock\": 12,\n  \"price\": 27999000\n}"
            },
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        },
        {
          "name": "Delete Item (DELETE /items/:id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        }
      ]
    }
  ]
}

